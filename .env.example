# ============================================================
# LottoGuard — Required Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — get these from your Supabase project settings > API
# Public URL and anon key are safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key — NEVER expose this in the browser or commit it
# Used only in server-side code and Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
